#version 450 core

struct Vertex {
    float x;
    float y;
    float z;
    uint color;
    float u;
    float v;
    uint overlay;
    uint light;
    uint normal;
};

#ifdef IRIS_ENTITY
struct IrisVertex {
    Vertex base;
    uint entityIds;
    uint itemId;
    float midU;
    float midV;
    uint tangent;
};
#endif

struct MeshInfo {
    uint vertexOffset;
    uint varyingOffset;
    int sharing;
    int shouldCull;
    uint color;
    uint overlay;
    uint light;
#ifdef IRIS_ENTITY
    uint entityIds;
    uint itemId;
#endif
};

struct Pose {
    mat4 position;
    mat3 normal;
};

layout(local_size_x = 128) in;
#ifdef IRIS_ENTITY
layout(std430, binding = 1) writeonly buffer Vertices { IrisVertex vertices[]; };
#else
layout(std430, binding = 1) writeonly buffer Vertices { Vertex vertices[]; };
#endif
layout(std430, binding = 2) readonly buffer Poses { Pose poses[]; };
layout(std430, binding = 4) writeonly buffer Varyings { ivec4 varyings[]; };
layout(std430, binding = 7) readonly buffer Meshes { Vertex meshVertices[]; };
layout(std430, binding = 8) readonly buffer Instances { MeshInfo instances[]; };
layout(location = 0) uniform uint meshCount;
layout(location = 1) uniform uint meshSize;
layout(location = 2) uniform uint meshOffset;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint instance = index / meshSize;
    if (instance >= meshCount) {
        return;
    }
    uint vertexIndex = index % meshSize;
    MeshInfo info = instances[instance];
    Vertex vertex = meshVertices[meshOffset + vertexIndex];
    // The source overlay word stores the bone and the Gecko flat-normal flags.
    int sharing = info.sharing + int(vertex.overlay & 0xffffu);
    Pose pose = poses[sharing];
    vec4 position = pose.position * vec4(vertex.x, vertex.y, vertex.z, 1.0);
    vec3 normal = pose.normal * unpackSnorm4x8(vertex.normal).xyz;
    uint flatAxes = vertex.overlay >> 16u;
    if ((flatAxes & 1u) != 0u) normal.x = abs(normal.x);
    if ((flatAxes & 2u) != 0u) normal.y = abs(normal.y);
    if ((flatAxes & 4u) != 0u) normal.z = abs(normal.z);
    uint color = packUnorm4x8(unpackUnorm4x8(info.color) * unpackUnorm4x8(vertex.color));
    uvec2 light = max(floatBitsToUint(unpackSnorm2x16(info.light)),
                     floatBitsToUint(unpackSnorm2x16(vertex.light)));
    Vertex transformed = Vertex(
        position.x, position.y, position.z, color, vertex.u, vertex.v,
        info.overlay, packSnorm2x16(uintBitsToFloat(light)),
        packSnorm4x8(vec4(normalize(normal), 0.0))
    );
    uint destination = info.vertexOffset + vertexIndex;
#ifdef IRIS_ENTITY
    // AR's polygon pass computes the final mid-UV and tangent when enabled.
    vertices[destination] = IrisVertex(transformed, info.entityIds, info.itemId & 0xffffu, 0.0, 0.0, 0u);
#else
    vertices[destination] = transformed;
#endif
    varyings[info.varyingOffset + vertexIndex] = ivec4(0, sharing, -1, info.shouldCull);
}
