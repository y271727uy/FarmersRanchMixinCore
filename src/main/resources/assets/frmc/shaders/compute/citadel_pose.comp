#version 450 core

layout(local_size_x = 64) in;

struct LocalPose {
    vec4 translation;
    vec4 angles;
    vec4 scale;
    ivec4 hierarchy; // parent, depth, scaleChildren, unused
};

// Matches the position and normal matrix layout in AR's entity shaders.
struct Pose {
    mat4 position;
    mat3 normal;
};

layout(std430, binding = 0) readonly buffer Inputs {
    LocalPose localPoses[];
};
layout(std430, binding = 1) writeonly buffer Outputs {
    Pose poses[];
};
layout(std430, binding = 2) readonly buffer BatchOffsets {
    uint offsets[];
};
layout(location = 0) uniform int boneCount;
layout(location = 1) uniform int maxDepth;
layout(location = 2) uniform bool renderBatch;

shared Pose inherited[64];

mat3 rotationZYX(vec3 angles) {
    vec3 halfAngles = angles * 0.5;
    vec3 s = sin(halfAngles);
    // Match JOML's cosine reconstruction from the half-angle sine.
    precise vec3 cosineSquared = 1.0 - s * s;
    vec3 c = sqrt(max(vec3(0.0), cosineSquared));
    bvec3 negative = greaterThanEqual(mod(halfAngles + 1.5707964, 6.2831855), vec3(3.1415927));
    c = mix(c, -c, negative);
    vec3 q = vec3(c.z * c.y * s.x - s.z * s.y * c.x,
                  c.z * s.y * c.x + s.z * c.y * s.x,
                  s.z * c.y * c.x - c.z * s.y * s.x);
    float w = c.z * c.y * c.x + s.z * s.y * s.x;
    vec3 d = q + q;
    return mat3(
        1.0 - q.y * d.y - q.z * d.z, q.x * d.y + w * d.z, q.x * d.z - w * d.y,
        q.x * d.y - w * d.z, 1.0 - q.x * d.x - q.z * d.z, q.y * d.z + w * d.x,
        q.x * d.z + w * d.y, q.y * d.z - w * d.x, 1.0 - q.x * d.x - q.y * d.y
    );
}

vec3 normalScale(vec3 scale) {
    if (scale.x == scale.y && scale.y == scale.z) {
        return vec3(1.0);
    }
    precise vec3 inverseScale = 1.0 / scale;
    precise float volume = inverseScale.x * inverseScale.y * inverseScale.z;
    // PoseStack uses Minecraft's fast inverse cube root, including its two refinement steps.
    precise float factor = intBitsToFloat(1419967116 - floatBitsToInt(volume) / 3);
    factor = 0.6666667 * factor + 1.0 / (3.0 * factor * factor * volume);
    factor = 0.6666667 * factor + 1.0 / (3.0 * factor * factor * volume);
    return inverseScale * factor;
}

void main() {
    int bone = int(gl_LocalInvocationID.x);
    int count = boneCount;
    int depthLimit = maxDepth;
    uint inputBase = gl_WorkGroupID.x * uint(boneCount);
    uint outputBase = inputBase;
    mat4 rootPosition = mat4(1.0);
    mat3 rootNormal = mat3(1.0);
    if (renderBatch) {
        uint header = offsets[gl_WorkGroupID.x];
        LocalPose basePosition = localPoses[header];
        LocalPose baseNormal = localPoses[header + 1u];
        rootPosition = mat4(basePosition.translation, basePosition.angles, basePosition.scale,
                            intBitsToFloat(basePosition.hierarchy));
        rootNormal = mat3(baseNormal.translation.xyz, baseNormal.angles.xyz, baseNormal.scale.xyz);
        count = baseNormal.hierarchy.x;
        depthLimit = baseNormal.hierarchy.y;
        outputBase = uint(baseNormal.hierarchy.z);
        inputBase = header + 2u;
    }
    uint index = inputBase + uint(bone);
    for (int depth = 0; depth <= depthLimit; depth++) {
        if (bone < count && localPoses[index].hierarchy.y == depth) {
            LocalPose local = localPoses[index];
            mat3 rotation = rotationZYX(local.angles.xyz);
            vec3 scale = local.scale.xyz;
            vec3 normals = normalScale(scale);
            mat4 position = mat4(vec4(rotation[0] * scale.x, 0.0),
                                 vec4(rotation[1] * scale.y, 0.0),
                                 vec4(rotation[2] * scale.z, 0.0),
                                 vec4(local.translation.xyz, 1.0));
            mat3 normal = mat3(rotation[0] * normals.x, rotation[1] * normals.y, rotation[2] * normals.z);
            int parent = local.hierarchy.x;
            if (parent >= 0) {
                position = inherited[parent].position * position;
                normal = inherited[parent].normal * normal;
            } else {
                position = rootPosition * position;
                normal = rootNormal * normal;
            }
            poses[outputBase + uint(bone)] = Pose(position, normal);
            if (local.hierarchy.z == 0) {
                vec3 compensation = 1.0 / max(scale, vec3(0.0001));
                vec3 normalCompensation = normalScale(compensation);
                for (int axis = 0; axis < 3; axis++) {
                    position[axis] *= compensation[axis];
                    normal[axis] *= normalCompensation[axis];
                }
            }
            inherited[bone] = Pose(position, normal);
        }
        barrier();
    }
}
