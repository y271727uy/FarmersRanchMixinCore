#version 450 core

struct Vertex {
    float x;
    float y;
    float z;
    uint color;
    float u;
    float v;
    uint overlay;
    uint light;
    uint normal;
};

struct MeshInfo {
    uint vertexOffset;
    uint varyingOffset;
    int sharing;
    int shouldCull;
    uint color;
    uint overlay;
    uint light;
};

struct Pose {
    mat4 position;
    mat3 normal;
};

struct PartBounds {
    vec3 low;
    uint first;
    vec3 high;
    uint count;
};

layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Results {
    uint modelUndersides;
    uint projectedCCW;
    uint projectedCW;
    uint depthChecked;
    uint terrainCovered;
    uint terrainCoveredCCW;
    uint skippedRaster;
    uint partsOutsideFrustum;
    uint partsTerrainCovered;
    uint partQuadsSkipped;
};
layout(std430, binding = 1) buffer Vertices { Vertex vertices[]; };
layout(std430, binding = 2) readonly buffer Poses { Pose poses[]; };
layout(std430, binding = 3) readonly buffer Parts { PartBounds parts[]; };
layout(std430, binding = 7) readonly buffer Meshes { Vertex meshVertices[]; };
layout(std430, binding = 8) readonly buffer Instances { MeshInfo instances[]; };
layout(binding = 0) uniform sampler2D terrainDepth;
layout(location = 0) uniform uint meshCount;
layout(location = 1) uniform uint meshSize;
layout(location = 2) uniform uint meshOffset;
layout(location = 3) uniform mat4 viewProjection;
layout(location = 7) uniform uint diagnosticInstances;
layout(location = 8) uniform bool skipRaster;
layout(location = 9) uniform uint partCount;

float signedArea(vec2 a, vec2 b, vec2 c) {
    vec2 ab = b - a;
    vec2 ac = c - a;
    return ab.x * ac.y - ab.y * ac.x;
}

bool depthBounds(vec2 low, vec2 high, int budget, out ivec2 start, out ivec2 end) {
    ivec2 size = textureSize(terrainDepth, 0);
    // Padding keeps screen-edge and subpixel ambiguities visible.
    start = ivec2(floor(low * vec2(size))) - 1;
    end = ivec2(ceil(high * vec2(size))) + 1;
    ivec2 extent = end - start;
    return all(greaterThanEqual(start, ivec2(0))) && all(lessThanEqual(end, size))
            && extent.x * extent.y <= budget;
}

bool coveredByTerrain(ivec2 start, ivec2 end, float nearestDepth) {
    float cutoff = nearestDepth - 1e-5;
    if (!(texelFetch(terrainDepth, (start + end) / 2, 0).r < cutoff)) {
        return false;
    }
    for (int y = start.y; y < end.y; y++) {
        for (int x = start.x; x < end.x; x++) {
            if (!(texelFetch(terrainDepth, ivec2(x, y), 0).r < cutoff)) {
                return false;
            }
        }
    }
    return true;
}

void collapse(uint first, uint count) {
    // BASEVERTEX uses shared sequential indices. A hidden range becomes degenerate triangles.
    Vertex anchor = vertices[first];
    for (uint i = 1u; i < count; i++) {
        vertices[first + i].x = anchor.x;
        vertices[first + i].y = anchor.y;
        vertices[first + i].z = anchor.z;
    }
}

void processPart() {
    uint index = gl_GlobalInvocationID.x;
    uint instance = index / partCount;
    if (instance >= meshCount) {
        return;
    }
    PartBounds part = parts[index % partCount];
    MeshInfo info = instances[instance];
    int bone = int(meshVertices[meshOffset + part.first].overlay);
    mat4 pose = poses[info.sharing + bone].position;
    vec3 positive = vec3(1e30);
    vec3 negative = vec3(1e30);
    vec3 low = vec3(1.0);
    vec2 high = vec2(0.0);
    bool inside = true;
    for (int i = 0; i < 8; i++) {
        vec3 corner = mix(part.low, part.high, bvec3((i & 1) != 0, (i & 2) != 0, (i & 4) != 0));
        vec3 position = (pose * vec4(corner, 1.0)).xyz;
        vec4 clip = viewProjection * vec4(position, 1.0);
        if (any(isnan(clip)) || any(isinf(clip))) {
            return;
        }
        float margin = 1e-5 * max(1.0, abs(clip.w));
        positive = min(positive, clip.xyz - (clip.w + margin));
        negative = min(negative, -clip.xyz - (clip.w + margin));
        if (clip.w <= margin || any(greaterThanEqual(abs(clip.xyz), vec3(clip.w - margin)))) {
            inside = false;
        } else {
            vec3 screen = (clip.xyz / clip.w) * 0.5 + 0.5;
            low = min(low, screen);
            high = max(high, screen.xy);
        }
    }
    // A part can be rejected only if all corners lie beyond the same clip plane.
    bool outside = any(greaterThan(positive, vec3(0.0))) || any(greaterThan(negative, vec3(0.0)));
    if (!outside) {
        ivec2 start, end;
        const int partRasterBudget = 384;
        if (!inside || !depthBounds(low.xy, high, partRasterBudget, start, end)
                || !coveredByTerrain(start, end, low.z)) {
            return;
        }
    }
    collapse(info.vertexOffset + part.first, part.count);
    if (instance < diagnosticInstances) {
        if (outside) {
            atomicAdd(partsOutsideFrustum, 1u);
        } else {
            atomicAdd(partsTerrainCovered, 1u);
        }
        atomicAdd(partQuadsSkipped, part.count / 4u);
    }
}

void processBottomFace() {
    uint quadsPerInstance = meshSize / 4u;
    uint quad = gl_GlobalInvocationID.x;
    uint instance = quad / quadsPerInstance;
    if (instance >= meshCount) {
        return;
    }
    uint first = meshOffset + (quad % quadsPerInstance) * 4u;
    bool measure = instance < diagnosticInstances;
    uint bone = meshVertices[first].overlay;
    if (unpackSnorm4x8(meshVertices[first].normal).y < 0.99) {
        return;
    }
    for (uint i = 1u; i < 4u; i++) {
        Vertex v = meshVertices[first + i];
        // Citadel's unposed model Y axis points down.
        if (v.overlay != bone || unpackSnorm4x8(v.normal).y < 0.99) {
            return;
        }
    }
    if (measure) {
        atomicAdd(modelUndersides, 1u);
    }

    uint outputStart = instances[instance].vertexOffset + (quad % quadsPerInstance) * 4u;
    vec3 ndc[4];
    for (uint i = 0u; i < 4u; i++) {
        Vertex v = vertices[outputStart + i];
        vec4 clip = viewProjection * vec4(v.x, v.y, v.z, 1.0);
        if (clip.w <= 0.0 || any(isnan(clip)) || any(isinf(clip))
                || any(greaterThanEqual(abs(clip.xyz), vec3(clip.w)))) {
            return;
        }
        ndc[i] = clip.xyz / clip.w;
    }
    float firstArea = signedArea(ndc[0].xy, ndc[1].xy, ndc[2].xy);
    float secondArea = signedArea(ndc[2].xy, ndc[3].xy, ndc[0].xy);
    const float minArea = 1e-10;
    bool ccw = firstArea > minArea && secondArea > minArea;
    bool cw = firstArea < -minArea && secondArea < -minArea;
    if (!ccw && !cw) {
        return;
    }
    if (measure) {
        if (ccw) {
            atomicAdd(projectedCCW, 1u);
        } else {
            atomicAdd(projectedCW, 1u);
        }
    }

    vec3 low = min(min(ndc[0], ndc[1]), min(ndc[2], ndc[3])) * 0.5 + 0.5;
    vec2 high = max(max(ndc[0].xy, ndc[1].xy), max(ndc[2].xy, ndc[3].xy)) * 0.5 + 0.5;
    // Test a padded rectangle and the quad's nearest depth. Any gap leaves it unproven.
    ivec2 start, end;
    // Bound per-face work during normal rendering. The one-frame probe can inspect larger faces.
    const int rasterBudget = 128;
    if (!depthBounds(low.xy, high, measure ? 1024 : rasterBudget, start, end)) {
        return;
    }
    if (measure) {
        atomicAdd(depthChecked, 1u);
    }
    if (!coveredByTerrain(start, end, low.z)) {
        return;
    }
    if (measure) {
        atomicAdd(terrainCovered, 1u);
        if (ccw) {
            atomicAdd(terrainCoveredCCW, 1u);
        }
    }
    if (skipRaster && (end.x - start.x) * (end.y - start.y) <= rasterBudget) {
        collapse(outputStart, 4u);
        if (measure) {
            atomicAdd(skippedRaster, 1u);
        }
    }
}

void main() {
    if (partCount != 0u) {
        processPart();
    } else {
        processBottomFace();
    }
}
